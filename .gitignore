# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Intermediate data — produced by the scripts, not committed.
# NOTE: the raw files in data/*.csv ARE committed.
data/processed/*
!data/processed/.gitkeep

# ...but the frozen train/dev/test split IS committed, deliberately. Everyone has to
# train and evaluate on the same rows or no two results are comparable, so the split
# is checked in rather than regenerated per machine.
!data/processed/train.csv
!data/processed/dev.csv
!data/processed/test.csv
!data/processed/split_manifest.json

# Committed data deliverables: the reproducible profiling stats and the readable
# split/profile reports the write-up is built from (MODEL_PLAN.md sections 2, 4).
!data/processed/split_report.md
!data/processed/profile_report.md
!data/processed/profile_stats.json

# Generated model artefacts
*.pt
*.joblib
*.pkl

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
